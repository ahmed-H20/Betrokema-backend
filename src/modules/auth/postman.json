    },
    {
      "name": "2. الملف الشخصي والتحقق (/me)",
      "item": [
        {
          "name": "2.1 جلب بيانات المستخدم الحالي وصلاحياته (Get Current User Profile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var res = pm.response.json();",
                  "pm.test(\"Profile returns authenticated user object\", function () {",
                  "    pm.expect(res.data).to.have.property(\"_id\");",
                  "    pm.expect(res.data).to.have.property(\"role\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/me",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "يتحقق من صحة وصلاحية التوكن (JWT Token) ويجلب بيانات الحساب الحالي كاملة بما في ذلك الصلاحية (admin / seller / client) والملفات الميدانية المقترنة."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. أمان الحساب وتغيير كلمة المرور (Password Security)",
      "item": [
        {
          "name": "3.1 تحديث كلمة المرور للمستخدم المسجل (Change Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (pm.response.code === 200 && res.token) {",
                  "    pm.collectionVariables.set(\"TOKEN\", res.token);",
                  "    pm.environment.set(\"TOKEN\", res.token);",
                  "    console.log(\"Refreshed JWT Token:\", res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{DEFAULT_PASSWORD}}\",\n  \"newPassword\": \"NewPassword@2026\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/change-password",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "auth", "change-password"]
            },
            "description": "تحديث كلمة المرور مع التحقق من كلمة المرور السابقة وإصدار توكن جديد ومحدث للجلسة."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. اختبارات الأمان والتحقق من الأخطاء (Security & Error Scenarios)",
      "item": [
        {
          "name": "4.1 محاولة دخول ببيانات غير صحيحة (401 Invalid Credentials)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "var res = pm.response.json();",
                  "pm.test(\"Returns error message in Arabic\", function () {",
                  "    pm.expect(res.message).to.include(\"غير صحيحة\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"INVALID_CODE_99\",\n  \"password\": \"WrongPass99!\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "فحص رفض تسجيل الدخول عند إدخال كود أو كلمة مرور غير مطابقة مع كود الحالة 401."
          },
          "response": []
        },
