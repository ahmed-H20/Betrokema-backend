    "name": "بترو كيما - مناديب المبيعات والعملاء (Sales Reps & Field Clients API)",
    "description": "مجموعة طلبات Postman تغطي كافة متطلبات شاشة مناديب المبيعات والعملاء الميدانيين: كروت الـ 4 KPIs، القائمة الجانبية مع التارجت ونسبة الإنجاز، بانر ملف المندوب ومؤشرات الأداء المالي، ومحفظة عملاء المندوب مع الائتمان والمديونيات.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:8400",
      "type": "string"
    },
    {
      "key": "SELLER_ID",
      "value": "671158a12c4b5d6e7f890222",
      "type": "string"
    },
    {
      "key": "CLIENT_ID",
      "value": "671158a12c4b5d6e7f890111",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. مؤشرات الأداء والـ KPIs (Dashboard Stats)",
      "item": [
        {
          "name": "كروت إحصائيات المناديب والفريق (Top 4 KPIs)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/sellers/stats",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "sellers", "stats"]
            },
            "description": "يرجع: إجمالي المناديب المعتمدين وتوزيعهم (نشط/معلق/إجازة)، إجمالي مبيعات الفريق ومستهدف الشهر ونسبة النمو، نسبة تحقيق التارجت العام وعدد الأيام للإغلاق، والعملاء الميدانيين النشطين."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. قائمة المناديب وتتبع الأداء (Sellers List & Filters)",
      "item": [
        {
          "name": "عرض قائمة المناديب كاملة مع التارجت ونسب الإنجاز",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/sellers?sort=performance",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "sellers"],
              "query": [
                {
                  "key": "sort",
                  "value": "performance",
                  "description": "ترتيب حسب الأداء (نسبة الإنجاز)"
                }
              ]
            },
            "description": "يجلب عناصر القائمة الجانبية: كود المندوب، حالته، مبيعاته، مستهدفه، نسبة الإنجاز، عدد عملائه، وفواتيره."
          },
          "response": []
        },
        {
          "name": "فلترة المناديب حسب المحافظة",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/sellers?governorate=القاهرة",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "sellers"],
              "query": [
                { "key": "governorate", "value": "القاهرة" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "بحث في المناديب بالاسم أو الكود",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/sellers?search=أحمد",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "sellers"],
              "query": [
                { "key": "search", "value": "أحمد" }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
