    {
      "name": "3. جدول توزيع المنتجات والكميات (Warehouse Stock & Bins Table)",
      "item": [
        {
          "name": "عرض أصناف المستودع المختار (جدول توزيع المنتجات والكميات)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/warehouses/{{WAREHOUSE_ID}}/inventory?page=1&limit=10",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "warehouses", "{{WAREHOUSE_ID}}", "inventory"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "يرجع بيانات الجدول: المنتج والتوصيف الفني، كود الصنف (SKU)، وحدة التعبئة، موقع الرف والتخزين (binLocation)، الرصيد الفعلي الحالي، حد إعادة الطلب، وحالة التوفر."
          },
          "response": []
