      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. مؤشرات الـ KPIs العلوية (Top 3 KPI Cards)",
      "item": [
        {
          "name": "إحصائيات ومؤشرات لوحة المخازن (Top 3 KPIs)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/warehouses/stats",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "warehouses", "stats"]
            },
            "description": "يرجع مؤشرات الكروت الثلاثة: 1. إجمالي المستودعات وأسماء الفروع (العاشر، السادات، برج العرب، أسيوط)، 2. رصيد المنتجات والكيماويات الإجمالي ونسبة الإشغال وسعة البالتات، 3. عدد طلبات المناقلة المعلقة والأرصدة الحرجة."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. إدارة المستودعات الإقليمية (Regional Warehouses CRUD)",
      "item": [
        {
          "name": "عرض كافة المستودعات المعتمدة (الكل 4)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/warehouses",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "warehouses"]
            },
            "description": "يرجع قائمة المستودعات كاملة مع نسبة الإشغال (occupancyRate%)، المنتجات المربوطة (linkedProductsCount)، والرصيد الفعلي الإجمالي (actualStockUnits)."
          },
          "response": []
        },
        {
          "name": "فلترة المستودعات النشطة فقط (نشط 3)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/warehouses?filter=active",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "warehouses"],
              "query": [
                {
                  "key": "filter",
                  "value": "active"
                }
              ]
            },
            "description": "عرض المستودعات المفعلة فقط والتي تستقبل حركات مخزنية."
          },
          "response": []
        },
        {
          "name": "البحث في المستودعات (بالاسم، الكود، أو المحافظة)",
          "request": {
            "method": "GET",
